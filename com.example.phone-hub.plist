<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.phone-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/cisco-phone/.venv/bin/python</string>
    <string>/Users/you/cisco-phone/phone_hub.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/you/cisco-phone</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/you/cisco-phone/phone_hub.log</string>
  <key>StandardErrorPath</key><string>/Users/you/cisco-phone/phone_hub.log</string>
</dict>
</plist>
